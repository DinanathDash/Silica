{
    "version": 1,
    "id": "vscode",
    "title": "VSCode",
    "fixed": [
        {
            "id": "settings",
            "title": "Settings",
            "key": ",",
            "mods": ["cmd"]
        },
        {
            "id": "new_file",
            "title": "New File",
            "key": "n",
            "mods": ["cmd"]
        },
        {
            "id": "new_folder",
            "title": "New Folder",
            "key": "n",
            "mods": ["shift", "cmd"]
        },
        {
            "id": "open",
            "title": "Open…",
            "key": "o",
            "mods": ["cmd"]
        },
        {
            "id": "welcome_window",
            "title": "Welcome Window",
            "key": "0",
            "mods": ["cmd"]
        },
        {
            "id": "save",
            "title": "Save",
            "key": "s",
            "mods": ["cmd"]
        },
        {
            "id": "save_as",
            "title": "Save As…",
            "key": "s",
            "mods": ["shift", "cmd"]
        },
        {
            "id": "save_all",
            "title": "Save All",
            "key": "s",
            "mods": ["opt", "cmd"]
        },
        {
            "id": "close_tab",
            "title": "Close Tab",
            "key": "w",
            "mods": ["cmd"]
        },
        {
            "id": "close_window",
            "title": "Close Window",
            "key": "w",
            "mods": ["shift", "cmd"]
        },
        {
            "id": "explorer",
            "title": "Explorer",
            "key": "e",
            "mods": ["shift", "cmd"]
        },
        {
            "id": "refresh_explorer",
            "title": "Refresh Explorer",
            "key": "r",
            "mods": ["shift", "cmd"]
        },
        {
            "id": "indent",
            "title": "Indent",
            "key": "]",
            "mods": ["cmd"]
        },
        {
            "id": "outdent",
            "title": "Outdent",
            "key": "[",
            "mods": ["cmd"]
        }
    ],
    "configurable": [
        {
            "id": "quick_open",
            "title": "Quick Open",
            "key": "p",
            "mods": ["cmd"]
        },
        {
            "id": "find_in_project",
            "title": "Find in Project",
            "key": "f",
            "mods": ["shift", "cmd"]
        },
        {
            "id": "source_control",
            "title": "Source Control",
            "key": "g",
            "mods": ["ctrl", "shift"]
        },
        {
            "id": "filter_tree_files",
            "title": "Filter Files",
            "key": "f",
            "mods": ["opt", "cmd"]
        },
        {
            "id": "go_to_line",
            "title": "Go to Line",
            "key": "g",
            "mods": ["ctrl"]
        },
        {
            "id": "toggle_preview",
            "title": "Toggle Preview",
            "key": "v",
            "mods": ["shift", "cmd"]
        },
        {
            "id": "toggle_sidebar",
            "title": "Toggle Sidebar",
            "key": "b",
            "mods": ["cmd"]
        },
        {
            "id": "toggle_terminal",
            "title": "Toggle Terminal",
            "key": "`",
            "mods": ["ctrl"]
        },
        {
            "id": "new_terminal",
            "title": "New Terminal",
            "key": "`",
            "mods": ["ctrl", "shift"]
        },
        {
            "id": "clear_terminal",
            "title": "Clear Terminal",
            "key": "k",
            "mods": ["cmd"]
        },
        {
            "id": "select_next_tab",
            "title": "Select Next Tab",
            "key": "→",
            "mods": ["opt", "cmd"]
        },
        {
            "id": "select_previous_tab",
            "title": "Select Previous Tab",
            "key": "←",
            "mods": ["opt", "cmd"]
        },
        {
            "id": "toggle_comment",
            "title": "Toggle Comment",
            "key": "/",
            "mods": ["cmd"]
        },
        {
            "id": "move_line_up",
            "title": "Move Line Up",
            "key": "↑",
            "mods": ["opt"]
        },
        {
            "id": "move_line_down",
            "title": "Move Line Down",
            "key": "↓",
            "mods": ["opt"]
        },
        {
            "id": "duplicate_line_up",
            "title": "Duplicate Line Up",
            "key": "↑",
            "mods": ["shift", "opt"]
        },
        {
            "id": "duplicate_line_down",
            "title": "Duplicate Line Down",
            "key": "↓",
            "mods": ["shift", "opt"]
        },
        {
            "id": "toggle_word_wrap",
            "title": "Toggle Word Wrap",
            "key": "z",
            "mods": ["opt"]
        },
        {
            "id": "increase_font_size",
            "title": "Increase Font Size",
            "key": "+",
            "mods": ["cmd"]
        },
        {
            "id": "decrease_font_size",
            "title": "Decrease Font Size",
            "key": "-",
            "mods": ["cmd"]
        },
        {
            "id": "reset_font_size",
            "title": "Reset Font Size",
            "key": "0",
            "mods": ["ctrl", "cmd"]
        }
    ]
}
