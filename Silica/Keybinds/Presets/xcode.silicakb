{
    "version": 1,
    "id": "xcode",
    "title": "Xcode",
    "fixed": [
        {
            "id": "settings",
            "title": "Settings",
            "key": ",",
            "mods": ["cmd"]
        },
        {
            "id": "new_file",
            "title": "New File",
            "key": "n",
            "mods": ["cmd"]
        },
        {
            "id": "new_folder",
            "title": "New Folder",
            "key": "n",
            "mods": ["opt", "cmd"]
        },
        {
            "id": "open",
            "title": "Open…",
            "key": "o",
            "mods": ["cmd"]
        },
        {
            "id": "welcome_window",
            "title": "Welcome Window",
            "key": "0",
            "mods": ["cmd"]
        },
        {
            "id": "save",
            "title": "Save",
            "key": "s",
            "mods": ["cmd"]
        },
        {
            "id": "save_as",
            "title": "Save As…",
            "key": "s",
            "mods": ["shift", "cmd"]
        },
        {
            "id": "save_all",
            "title": "Save All",
            "key": "s",
            "mods": ["opt", "cmd"]
        },
        {
            "id": "close_tab",
            "title": "Close Tab",
            "key": "w",
            "mods": ["cmd"]
        },
        {
            "id": "close_window",
            "title": "Close Window",
            "key": "w",
            "mods": ["shift", "cmd"]
        },
        {
            "id": "explorer",
            "title": "Explorer",
            "key": "1",
            "mods": ["cmd"]
        },
        {
            "id": "refresh_explorer",
            "title": "Refresh Explorer",
            "key": "r",
            "mods": ["shift", "cmd"]
        },
        {
            "id": "indent",
            "title": "Indent",
            "key": "]",
            "mods": ["cmd"]
        },
        {
            "id": "outdent",
            "title": "Outdent",
            "key": "[",
            "mods": ["cmd"]
        },
        {
            "id": "cut",
            "title": "Cut",
            "key": "x",
            "mods": ["cmd"]
        },
        {
            "id": "copy",
            "title": "Copy",
            "key": "c",
            "mods": ["cmd"]
        },
        {
            "id": "paste",
            "title": "Paste",
            "key": "v",
            "mods": ["cmd"]
        },
        {
            "id": "select_all",
            "title": "Select All",
            "key": "a",
            "mods": ["cmd"]
        },
        {
            "id": "undo",
            "title": "Undo",
            "key": "z",
            "mods": ["cmd"]
        },
        {
            "id": "redo",
            "title": "Redo",
            "key": "z",
            "mods": ["shift", "cmd"]
        },
        {
            "id": "minimize",
            "title": "Minimize",
            "key": "m",
            "mods": ["cmd"]
        },
        {
            "id": "hide",
            "title": "Hide Silica",
            "key": "h",
            "mods": ["cmd"]
        },
        {
            "id": "hide_others",
            "title": "Hide Others",
            "key": "h",
            "mods": ["opt", "cmd"]
        },
        {
            "id": "quit",
            "title": "Quit Silica",
            "key": "q",
            "mods": ["cmd"]
        }
    ],
    "configurable": [
        {
            "id": "quick_open",
            "title": "Quick Open",
            "key": "o",
            "mods": ["shift", "cmd"]
        },
        {
            "id": "quick_jump_to_file",
            "title": "Quick Jump to File",
            "key": "j",
            "mods": ["shift", "cmd"]
        },
        {
            "id": "find_in_project",
            "title": "Find in Project",
            "key": "f",
            "mods": ["shift", "cmd"]
        },
        {
            "id": "filter_tree_files",
            "title": "Filter Files",
            "key": "j",
            "mods": ["opt", "cmd"]
        },
        {
            "id": "go_to_line",
            "title": "Go to Line",
            "key": "l",
            "mods": ["cmd"]
        },
        {
            "id": "toggle_preview",
            "title": "Toggle Preview",
            "key": "⏎",
            "mods": ["opt", "cmd"]
        },
        {
            "id": "toggle_sidebar",
            "title": "Toggle Sidebar",
            "key": "1",
            "mods": ["shift", "cmd"]
        },
        {
            "id": "toggle_terminal",
            "title": "Toggle Terminal",
            "key": "y",
            "mods": ["shift", "cmd"]
        },
        {
            "id": "new_terminal",
            "title": "New Terminal",
            "key": "c",
            "mods": ["shift", "cmd"]
        },
        {
            "id": "clear_terminal",
            "title": "Clear Terminal",
            "key": "k",
            "mods": ["cmd"]
        },
        {
            "id": "select_next_tab",
            "title": "Select Next Tab",
            "key": "]",
            "mods": ["shift", "cmd"]
        },
        {
            "id": "select_previous_tab",
            "title": "Select Previous Tab",
            "key": "[",
            "mods": ["shift", "cmd"]
        },
        {
            "id": "toggle_comment",
            "title": "Toggle Comment",
            "key": "/",
            "mods": ["cmd"]
        },
        {
            "id": "move_line_up",
            "title": "Move Line Up",
            "key": "[",
            "mods": ["opt", "cmd"]
        },
        {
            "id": "move_line_down",
            "title": "Move Line Down",
            "key": "]",
            "mods": ["opt", "cmd"]
        },
        {
            "id": "duplicate_line_up",
            "title": "Duplicate Line Up",
            "key": "↑",
            "mods": ["shift", "opt"]
        },
        {
            "id": "duplicate_line_down",
            "title": "Duplicate Line Down",
            "key": "↓",
            "mods": ["shift", "opt"]
        },
        {
            "id": "toggle_word_wrap",
            "title": "Toggle Word Wrap",
            "key": "z",
            "mods": ["opt"]
        },
        {
            "id": "increase_font_size",
            "title": "Increase Font Size",
            "key": "+",
            "mods": ["cmd"]
        },
        {
            "id": "decrease_font_size",
            "title": "Decrease Font Size",
            "key": "-",
            "mods": ["cmd"]
        },
        {
            "id": "reset_font_size",
            "title": "Reset Font Size",
            "key": "+",
            "mods": ["shift", "cmd"]
        }
    ]
}
